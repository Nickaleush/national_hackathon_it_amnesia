<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/myMessageTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/rounded_message_shape"
        android:maxWidth="292dp"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:fontFamily="@font/gteestiprotext_regular"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp"
        android:text="@string/Message"
        android:textColor="#ffffff"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:fontFamily="@font/gteestiprotext_regular"
        android:text="@string/DefaultTime"
        app:layout_constraintBottom_toBottomOf="@id/myMessageTextView"
        app:layout_constraintEnd_toStartOf="@id/myMessageTextView" />

</androidx.constraintlayout.widget.ConstraintLayout>
