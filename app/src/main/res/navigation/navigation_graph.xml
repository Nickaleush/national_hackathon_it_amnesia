<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/logoFragment">

    <fragment
        android:id="@+id/logoFragment"
        android:name="com.example.national_hackathon_it_amnesia.ui.logo.LogoFragment"
        android:label="LogoFragment"
        tools:layout="@layout/logo_fragment"
        >
        <action
            android:id="@+id/action_logoFragment_to_authFragment"
            app:destination="@id/authFragment"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/logoFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_logoFragment_to_registrationFragment"
            app:destination="@id/registrationFragment"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/logoFragment"
            app:popUpToInclusive="true"
            />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.national_hackathon_it_amnesia.ui.chat.ChatFragment"
        android:label="ChatFragment"
        tools:layout="@layout/chat_fragment" />

    <fragment
        android:id="@+id/authFragment"
        android:name="com.example.national_hackathon_it_amnesia.ui.auth.AuthFragment"
        android:label="AuthFragment"
        tools:layout="@layout/auth_fragment">
        <action
            android:id="@+id/action_authFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.example.national_hackathon_it_amnesia.ui.registration.RegistrationFragment"
        android:label="RegistrationFragment"
        tools:layout="@layout/registration_fragment">
        <action
            android:id="@+id/action_registrationFragment_to_createCodeFragment"
            app:destination="@id/createCodeFragment" />
    </fragment>
    <fragment
        android:id="@+id/createCodeFragment"
        android:name="com.example.national_hackathon_it_amnesia.ui.createCode.CreateCodeFragment"
        android:label="CreateCodeFragment"
        tools:layout="@layout/create_code_fragment">
        <action
            android:id="@+id/action_createCodeFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.national_hackathon_it_amnesia.ui.profile.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/profile_fragment">
        <action
            android:id="@+id/action_profileFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
    </fragment>


</navigation>